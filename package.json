{
  "name": "modak",
  "version": "1.0.0",
  "description": "모닥 - 음성·화면·소리 공유와 채팅",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.modak.app",
    "productName": "모닥",
    "files": [
      "main.js",
      "index.html",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg"
    },
    "icon": "build/icon.png",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}